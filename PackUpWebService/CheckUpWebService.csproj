<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	  <TargetFramework>net9.0</TargetFramework>
	<AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
	<ApplicationIcon />
	<OutputType>Exe</OutputType>
	<StartupObject />
	<UserSecretsId>5f282882-1342-40a0-8f67-4ad1cf567a55</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="3Chum.IdentityServer4.AccessTokenValidation" Version="8.0.0" />
	<PackageReference Include="AutoMapper.Data" Version="10.0.0" />
	<PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
	<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.0" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
	<PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.0" />
	<PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\AcraData\AcraData.csproj" />
	<ProjectReference Include="..\AcraUtils\AcraUtils.csproj" />
	<ProjectReference Include="..\PackUpService\CheckUpService.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Content Update="log4net.config">
	  <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	</Content>
  </ItemGroup>

  <!-- Force-resolve Microsoft.Extensions.Primitives to version 10 to avoid NU1605 downgrade when transitive packages require v10 -->
  <ItemGroup>
	<PackageReference Update="Microsoft.Extensions.Primitives" Version="10.0.0" />
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>

</Project>
